# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Frontend env vars MUST start with VITE_ or Vite will not expose them.
# ---------------------------------------------------------------------------

# Supabase (Project Settings -> API)
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Optional: shown in the app footer / used for support links
VITE_APP_ENV="development"

# AI service (Phase 11). Base URL of the FastAPI service.
# The browser never sees an AI provider key — only this service URL.
VITE_AI_SERVICE_URL="http://localhost:8000"
